# ============================================================
# AI Job Searcher - Optional Environment Variables (.env)
# ============================================================

# LLM Providers (Free Cloud or Local)
# If using Groq (Fast & 100% Free - 14,400 req/day):
GROQ_API_KEY=
# If using local Ollama:
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest

# Notifications Master Switch
NOTIFICATIONS_ENABLED=true
NOTIFICATION_MIN_SCORE=60

# ------------------------------------------------------------
# Option 1: WhatsApp Instant Alerts via CallMeBot (100% Free)
# ------------------------------------------------------------
# Step 1: Add phone +34 941 86 01 02 to your WhatsApp contacts
# Step 2: Send WhatsApp text: "I allow callmebot to send me messages"
# Step 3: CallMeBot will reply with your API Key
WHATSAPP_ENABLED=false
CALLMEBOT_PHONE=919876543210
CALLMEBOT_API_KEY=your_key_here

# ------------------------------------------------------------
# Option 2: Gmail SMTP Email Alerts (Full JD + 1-Click Apply)
# ------------------------------------------------------------
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
RECIPIENT_EMAIL=your-email@gmail.com

# ------------------------------------------------------------
# Option 3: Telegram Bot Alerts
# ------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
